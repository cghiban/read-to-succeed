<!DOCTYPE html>

<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inconsolata">
        <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
        <link rel="stylesheet" href="/static/styles.css">
        <title>Groups Reading Log - Read to Succeed</title>
    </head>
  <body>
    {{ block "menu_burger" .}}{{end}}

    <h1>Groups Reading Log</h1>

  {{if not .GroupList }}
    {{ if .Readings }}
    <div style="overflow-x:auto;" id="content">
      <table>
        <thead>
        <tr>
          <th>Group</th>
          <th>Reader</th>
          <th>Author</th>
          <th>Title</th>
          <th>Day</th>
          <th>Duration</th>
          <th>Pages</th>
        </tr>
        </thead>
        <tbody>
      {{ range .Readings}}
      <tr>
          <td><a href="/groupreadings?group={{.GroupID}}">{{.GroupName}}</a></td>
          <td>{{.ReaderName}}</td>
          <td>{{.BookAuthor}}</td>
          <td>{{.BookTitle}}</td>
          <td>{{dayToDate .Day}}</td>
          <td>{{.Duration}}m</td>
          <td>{{.Pages}}</td>
      </tr>
      {{ end }}
      <tbody>
      </table>
      {{block "pagination" .}}{{end}}
    </div>
    {{else}}
      {{ if .GroupID }}
      <p>No activityin this group. Add some readings...</p>
      {{ else }}
      <p>Join a group and add some readings...</p>
      {{ end }}
    {{end}}
  {{else}}
    <p>Pick a group below:</p>
    <ul>
    {{ range .GroupList}}
      <li><a href="/groupreadings?group={{.GroupID}}">{{.GroupName}}</a> ({{.MemberCount}})</li>
    {{end}}
    </ul>
  {{end}}
  </body>
</html>
